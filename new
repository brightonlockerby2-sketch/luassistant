async function handleSendMessage() {
    const message = userInput.value.trim();
    if (!message && !currentImage) return;

    hideError();

    const welcomeScreen = document.querySelector('.welcome-screen');
    if (welcomeScreen) welcomeScreen.remove();

    // Combine typed message with any pasted code block
    const fullMessage = pastedCode
        ? (message ? `${message}\n\n\`\`\`\n${pastedCode}\n\`\`\`` : `\`\`\`\n${pastedCode}\n\`\`\``)
        : message;

    // Check if this is an image generation request
    const imageGenPrompt = detectImageGenPrompt(fullMessage);

    const thinkingStatus = deepThinkEnabled ? 'Deep Thinking' : detectThinkingStatus(fullMessage);
    addMessage(fullMessage, 'user', currentImage);

    const imageToSend = currentImage;
    userInput.value = '';
    removeImage();
    removePastedCode();
    autoResizeTextarea();
    updateSendButton();

    // Show stop button, hide send button
    const stopBtn = document.getElementById('stopBtn');
    stopBtn.classList.add('visible');
    sendBtn.style.display = 'none';

    currentAbortController = new AbortController();

    if (imageGenPrompt) {
        // --- IMAGE GENERATION PATH ---
        try {
            await generateAndShowImage(imageGenPrompt, currentAbortController.signal);
        } catch (error) {
            if (error.name === 'AbortError') {
                const cancelDiv = document.createElement('div');
                cancelDiv.className = 'message bot-message';
                cancelDiv.innerHTML = `<div class="message-avatar bot-avatar">L</div><div class="message-content" style="color:var(--text-secondary);font-style:italic;padding-top:4px">Generation stopped.</div>`;
                chatContainer.appendChild(cancelDiv);
            } else {
                showError('Image error: ' + error.message);
                console.error('Image gen error:', error);
            }
        } finally {
            stopBtn.classList.remove('visible');
            sendBtn.style.display = '';
            currentAbortController = null;
        }
    } else {
        // --- NORMAL AI TEXT PATH ---
        const thinkingMsg = showThinkingIndicator(thinkingStatus);
        const thinkStart = Date.now();

        try {
            const response = await getAIResponse(fullMessage, imageToSend, currentAbortController.signal);
            const thinkSecs = ((Date.now() - thinkStart) / 1000).toFixed(1);
            const thinkLabel = deepThinkEnabled ? `Deep thought for ${thinkSecs}s` : `Thought for ${thinkSecs}s`;
            thinkingMsg.remove();
            addMessage(response, 'bot', null, thinkLabel);
        } catch (error) {
            thinkingMsg.remove();
            if (error.name === 'AbortError') {
                const cancelDiv = document.createElement('div');
                cancelDiv.className = 'message bot-message';
                cancelDiv.innerHTML = `<div class="message-avatar bot-avatar">L</div><div class="message-content" style="color:var(--text-secondary);font-style:italic;padding-top:4px">Generation stopped.</div>`;
                chatContainer.appendChild(cancelDiv);
            } else {
                showError('Error: ' + error.message);
                console.error('Error:', error);
            }
        } finally {
            stopBtn.classList.remove('visible');
            sendBtn.style.display = '';
            currentAbortController = null;
        }
    }

    scrollToBottom();
}

function handleStop() {
    if (currentAbortController) {
        currentAbortController.abort();
    }
}

