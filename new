<script>
// ============================================
// AI CONFIGURATION — Groq
// ============================================
const AI_CONFIG = {
    GROQ_API_KEY: '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',
    GROQ_MODEL_NORMAL: 'llama-3.3-70b-versatile',
    GROQ_MODEL_DEEP: 'qwen/qwen3-32b',  // reasoning model for deep think (supports <think> tags)
    GROQ_ENDPOINT: 'https://api.groq.com/openai/v1/chat/completions',
    CORS_PROXY: 'https://corsproxy.io/?'
};

// ============================================
// DOM Elements
// ============================================
const chatContainer = document.getElementById('chatContainer');
const userInput = document.getElementById('userInput');
const sendBtn = document.getElementById('sendBtn');
const sidebar = document.getElementById('sidebar');
const newChatBtn = document.getElementById('newChatBtn');
const chatList = document.getElementById('chatList');
const imageInput = document.getElementById('imageInput');
const attachBtn = document.getElementById('attachBtn');
const imagePreviewArea = document.getElementById('imagePreviewArea');
const imagePreview = document.getElementById('imagePreview');
const mobileMenuBtn = document.getElementById('mobileMenuBtn');
const sidebarToggle = document.getElementById('sidebarToggle');
const newChatNav = document.getElementById('newChatNav');
const errorBanner = document.getElementById('errorBanner');
const deepThinkBtn = document.getElementById('deepThinkBtn');
const authScreen = document.getElementById('authScreen');
const chatApp = document.getElementById('chatApp');
const loginForm = document.getElementById('loginForm');
const signupForm = document.getElementById('signupForm');
const userNameDisplay = document.getElementById('userName');
const userAvatar = document.getElementById('userAvatar');

// Chat state
let currentChatId = null;
let allChats = {};
let chatHistory = [];
let currentUser = null;
let currentImage = null;
let deepThinkEnabled = false;
let pastedCode = null; // stores large pasted code block separately
let currentAbortController = null; // for stop generation

// ============================================
// INIT
// ============================================
document.addEventListener('DOMContentLoaded', () => {
    loadTheme();
    checkAuth();
});

// ============================================
// AUTH
// ============================================
function checkAuth() {
    const savedUser = localStorage.getItem('currentUser');
    if (savedUser) {
        currentUser = JSON.parse(savedUser);
        showChatApp();
    } else {
        showAuthScreen();
    }
}

function showAuthScreen() {
    authScreen.style.display = 'flex';
    chatApp.style.display = 'none';
}

function showChatApp() {
    authScreen.style.display = 'none';
    chatApp.style.display = 'flex';
    userNameDisplay.textContent = currentUser.name;
    userAvatar.textContent = currentUser.name.charAt(0).toUpperCase();
    loadAllChats();
    // Restore last active chat, or create a new one if none exist
    const lastChatId = localStorage.getItem(`currentChatId_${currentUser.email}`);
    if (lastChatId && allChats[lastChatId]) {
        switchToChat(lastChatId);
    } else if (Object.keys(allChats).length > 0) {
        // Switch to the most recent chat
        const mostRecent = Object.values(allChats).sort((a, b) => b.createdAt - a.createdAt)[0];
        switchToChat(mostRecent.id);
    } else {
        createNewChat();
    }
    setupEventListeners();
}

function toggleAuthForm() {
    if (loginForm.style.display === 'none') {
        loginForm.style.display = 'block';
        signupForm.style.display = 'none';
    } else {
        loginForm.style.display = 'none';
        signupForm.style.display = 'block';
    }
}

function handleLogin() {
    const email = document.getElementById('loginEmail').value.trim().toLowerCase();
    const password = document.getElementById('loginPassword').value;
    if (!email || !password) { alert('Please fill in all fields'); return; }
    const users = JSON.parse(localStorage.getItem('users') || '{}');
    if (users[email] && users[email].password === password) {
        currentUser = { email, name: users[email].name };
        localStorage.setItem('currentUser', JSON.stringify(currentUser));
        showChatApp();
    } else if (!users[email]) {
        alert('No account found with that email.\n\nNote: accounts are saved in this browser only. If you signed up in a different browser or device, you\'ll need to create a new account.');
    } else {
        alert('Incorrect password. Please try again.');
    }
}

function handleSignup() {
    const name = document.getElementById('signupName').value.trim();
    const email = document.getElementById('signupEmail').value.trim().toLowerCase();
    const password = document.getElementById('signupPassword').value;
    const confirmPassword = document.getElementById('signupConfirmPassword').value;
    if (!name || !email || !password || !confirmPassword) { alert('Please fill in all fields'); return; }
    if (password !== confirmPassword) { alert('Passwords do not match'); return; }
    if (password.length < 6) { alert('Password must be at least 6 characters'); return; }
    const users = JSON.parse(localStorage.getItem('users') || '{}');
    if (users[email]) { alert('Email already registered'); return; }
    users[email] = { name, password };
    localStorage.setItem('users', JSON.stringify(users));
    currentUser = { email, name };
    localStorage.setItem('currentUser', JSON.stringify(currentUser));
    showChatApp();
}

function handleResetAccount() {
    const email = document.getElementById('loginEmail').value.trim().toLowerCase();
    if (!email) {
        alert('Enter your email address first, then click "Forgot password / reset account".');
        return;
    }
    if (confirm(`Reset account for "${email}"?\n\nThis will delete that account's saved data from this browser so you can sign up again with the same email.\n\nYour chat history will also be cleared.`)) {
        const users = JSON.parse(localStorage.getItem('users') || '{}');
        delete users[email];
        localStorage.setItem('users', JSON.stringify(users));
        localStorage.removeItem(`allChats_${email}`);
        localStorage.removeItem(`currentChatId_${email}`);
        alert('Account reset. You can now sign up again with that email.');
        toggleAuthForm(); // switch to sign up form
    }
}

function handleLogout() {
    if (confirm('Are you sure you want to logout?')) {
        localStorage.removeItem('currentUser');
        currentUser = null;
        currentChatId = null;
        allChats = {};
        chatHistory = [];
        showAuthScreen();
    }
}

// ============================================
// EVENT LISTENERS
// ============================================
function setupEventListeners() {
    sendBtn.addEventListener('click', handleSendMessage);
    document.getElementById('stopBtn').addEventListener('click', handleStop);
    userInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSendMessage(); }
    });
    userInput.addEventListener('input', () => { autoResizeTextarea(); updateSendButton(); });
    userInput.addEventListener('paste', handlePaste);
    mobileMenuBtn.addEventListener('click', () => sidebar.classList.add('active'));
    sidebarToggle.addEventListener('click', () => {
        sidebar.classList.toggle('collapsed');
        updateReopenBtn();
    });
    document.getElementById('sidebarReopenBtn').addEventListener('click', () => {
        sidebar.classList.remove('collapsed');
        updateReopenBtn();
    });
    document.getElementById('userMenuBtn').addEventListener('click', (e) => {
        e.stopPropagation();
        toggleSettings();
    });
    document.addEventListener('click', (e) => {
        const popup = document.getElementById('settingsPopup');
        if (popup.classList.contains('open') && !popup.contains(e.target) && !document.getElementById('userMenuBtn').contains(e.target)) {
            closeSettings();
        }
    });
    newChatBtn.addEventListener('click', () => { createNewChat(); sidebar.classList.remove('active'); });
    newChatNav.addEventListener('click', () => { createNewChat(); sidebar.classList.remove('active'); });
    attachBtn.addEventListener('click', () => imageInput.click());
    imageInput.addEventListener('change', handleImageUpload);

    // Deep Think toggle
    deepThinkBtn.addEventListener('click', () => {
        deepThinkEnabled = !deepThinkEnabled;
        deepThinkBtn.classList.toggle('active', deepThinkEnabled);
        deepThinkBtn.title = deepThinkEnabled ? 'Deep Think ON — click to disable' : 'Enable Deep Think';
    });
    document.addEventListener('click', (e) => {
        if (window.innerWidth <= 768 && sidebar.classList.contains('active') &&
            !sidebar.contains(e.target) && !mobileMenuBtn.contains(e.target)) {
            sidebar.classList.remove('active');
        }
    });
}

// ============================================
// IMAGE UPLOAD
// ============================================
function handleImageUpload(e) {
    const file = e.target.files[0];
    if (!file) return;
    if (!file.type.startsWith('image/')) { alert('Please select an image file'); return; }
    if (file.size > 5 * 1024 * 1024) { alert('Image size should be less than 5MB'); return; }
    const reader = new FileReader();
    reader.onload = (event) => {
        currentImage = event.target.result;
        imagePreview.src = currentImage;
        imagePreviewArea.style.display = 'block';
        updateSendButton();
    };
    reader.readAsDataURL(file);
}

function removeImage() {
    currentImage = null;
    imagePreview.src = '';
    imagePreviewArea.style.display = 'none';
    imageInput.value = '';
    updateSendButton();
}

function autoResizeTextarea() {
    userInput.style.height = 'auto';
    userInput.style.height = Math.min(userInput.scrollHeight, 120) + 'px';
}

function updateSendButton() {
    sendBtn.disabled = userInput.value.trim().length === 0 && !currentImage && !pastedCode;
}

// Threshold: collapse into card if pasted text is more than 300 chars or has 6+ lines
const CODE_PASTE_THRESHOLD_CHARS = 300;
const CODE_PASTE_THRESHOLD_LINES = 6;

function handlePaste(e) {
    const text = (e.clipboardData || window.clipboardData).getData('text');
    if (!text) return;
    const lineCount = text.split('\n').length;
    if (text.length >= CODE_PASTE_THRESHOLD_CHARS || lineCount >= CODE_PASTE_THRESHOLD_LINES) {
        e.preventDefault(); // stop it filling the textarea
        pastedCode = text;
        const preview = document.getElementById('codePastePreview');
        const card = document.getElementById('codePasteCard');
        preview.textContent = text;
        card.style.display = 'block';
        updateSendButton();
        // Make the card clickable to open right panel
        card.querySelector('.code-paste-card-inner').onclick = () => openCodePanel(text);
    }
}

function removePastedCode() {
    pastedCode = null;
    document.getElementById('codePasteCard').style.display = 'none';
    document.getElementById('codePastePreview').textContent = '';
    updateSendButton();
}

// ============================================
// THINKING STATUS
// ============================================
function detectThinkingStatus(message) {
    const lower = message.toLowerCase();
    if (lower.includes('code') || lower.includes('function') || lower.includes('script')) {
        if (lower.includes('python')) return 'Writing Python code';
        if (lower.includes('javascript') || lower.includes('js')) return 'Writing JavaScript';
        if (lower.includes('html') || lower.includes('css')) return 'Writing HTML/CSS';
        return 'Writing code';
    }
    if (lower.includes('explain') || lower.includes('what is') || lower.includes('how')) return 'Analyzing';
    if (lower.includes('debug') || lower.includes('fix') || lower.includes('error')) return 'Debugging';
    return 'Thinking';
}

