<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuaAssistant - AI Coding Companion</title>
    <style>
:root {
    --primary: #10a37f;
    --primary-hover: #0d8a6a;
    --bg-primary: #ffffff;
    --bg-secondary: #f7f7f8;
    --bg-tertiary: #ececf1;
    --sidebar-bg: #f9f9f9;
    --text-primary: #2e2e2e;
    --text-secondary: #6e6e80;
    --border: #e5e5e5;
    --user-msg: #f4f4f4;
    --bot-msg: #ffffff;
    --shadow: rgba(0, 0, 0, 0.05);
    --hover-bg: #f0f0f0;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: var(--bg-primary);
    color: var(--text-primary);
    height: 100vh;
    overflow: hidden;
}

/* Auth Screen */
.auth-screen {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    background: var(--bg-primary);
    padding: 20px;
}

.auth-container {
    background: var(--bg-primary);
    border-radius: 12px;
    padding: 48px 40px;
    max-width: 380px;
    width: 100%;
    box-shadow: 0 2px 16px var(--shadow);
}

.auth-header {
    text-align: center;
    margin-bottom: 32px;
}

.auth-logo {
    display: inline-flex;
    margin-bottom: 16px;
}

.auth-header h1 {
    font-size: 24px;
    margin-bottom: 8px;
    color: var(--text-primary);
    font-weight: 600;
}

.auth-header p {
    color: var(--text-secondary);
    font-size: 14px;
}

.auth-form h2 {
    font-size: 20px;
    margin-bottom: 24px;
    color: var(--text-primary);
    font-weight: 600;
}

.form-group {
    margin-bottom: 16px;
}

.form-group input {
    width: 100%;
    padding: 12px 14px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-primary);
    font-size: 15px;
    transition: all 0.2s;
}

.form-group input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(16, 163, 127, 0.1);
}

.auth-btn {
    width: 100%;
    padding: 12px;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 8px;
}

.auth-btn:hover {
    background: var(--primary-hover);
}

.auth-toggle {
    text-align: center;
    margin-top: 16px;
    color: var(--text-secondary);
    font-size: 14px;
}

.auth-toggle a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
}

.auth-toggle a:hover {
    text-decoration: underline;
}

/* Chat App Layout */
.chat-app {
    display: flex;
    height: 100vh;
    overflow: hidden;
}

/* Sidebar */
.sidebar {
    width: 260px;
    background: var(--sidebar-bg);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    transition: transform 0.3s ease;
}

.sidebar.collapsed {
    width: 0;
    overflow: hidden;
}

.sidebar-header {
    padding: 12px 8px;
    display: flex;
    gap: 8px;
    border-bottom: 1px solid var(--border);
}

.sidebar-toggle {
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 8px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
}

.sidebar-toggle:hover {
    background: var(--hover-bg);
}

.new-chat-btn {
    flex: 1;
    padding: 8px 12px;
    background: none;
    border: 1px solid var(--border);
    color: var(--text-primary);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background 0.2s;
}

.new-chat-btn:hover {
    background: var(--hover-bg);
}

.sidebar-content {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
}

.sidebar-nav {
    padding: 8px;
    border-bottom: 1px solid var(--border);
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    color: var(--text-primary);
    text-decoration: none;
    border-radius: 6px;
    font-size: 14px;
    transition: background 0.2s;
    margin-bottom: 4px;
    cursor: pointer;
    border: none;
    background: none;
    width: 100%;
    text-align: left;
}

.nav-item:hover {
    background: var(--hover-bg);
}

.chat-list {
    flex: 1;
    padding: 8px;
    overflow-y: auto;
}

.chat-item {
    padding: 10px 12px;
    margin-bottom: 4px;
    background: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s;
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
}

.chat-item:hover {
    background: var(--hover-bg);
}

.chat-item.active {
    background: var(--bg-tertiary);
}

.chat-item-title {
    font-size: 14px;
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
}

.delete-chat-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    font-size: 16px;
    opacity: 0;
    transition: opacity 0.2s;
}

.chat-item:hover .delete-chat-btn {
    opacity: 1;
}

.delete-chat-btn:hover {
    background: var(--bg-tertiary);
}

.sidebar-footer {
    padding: 12px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 8px;
}

.user-menu {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    background: none;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    color: var(--text-primary);
    font-size: 14px;
    transition: background 0.2s;
    overflow: hidden;
}

.user-menu:hover {
    background: var(--hover-bg);
}

.user-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 12px;
    flex-shrink: 0;
}

.user-menu span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.icon-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 6px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
}

.icon-btn:hover {
    background: var(--hover-bg);
}

/* Main Content */
.main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg-primary);
}

.top-bar {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg-primary);
}

.mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 8px;
    border-radius: 6px;
    transition: background 0.2s;
}

.mobile-menu-btn:hover {
    background: var(--hover-bg);
}

.model-name {
    font-size: 16px;
    font-weight: 600;
    flex: 1;
}

.top-bar-actions {
    display: flex;
    gap: 8px;
}

.chat-container {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
}

/* Welcome Screen */
.welcome-screen {
    max-width: 800px;
    margin: 120px auto;
    text-align: center;
}

.welcome-screen h2 {
    font-size: 32px;
    font-weight: 400;
    color: var(--text-primary);
}

/* Messages */
.message {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    animation: slideIn 0.3s ease;
}

@keyframes slideIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

.message-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-weight: 600;
    font-size: 14px;
}

.user-message .message-avatar {
    background: var(--text-primary);
    color: white;
}

.bot-message .message-avatar {
    background: var(--primary);
    color: white;
}

.message-content {
    flex: 1;
    padding-top: 4px;
    line-height: 1.7;
    font-size: 15px;
    color: var(--text-primary);
}

.message-image {
    max-width: 400px;
    border-radius: 12px;
    margin-bottom: 12px;
    display: block;
    border: 1px solid var(--border);
}

.thinking-status {
    color: var(--text-secondary);
    font-size: 13px;
    font-style: italic;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
}

/* Thinking mode block */
.thinking-block {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-left: 3px solid var(--primary);
    border-radius: 8px;
    margin-bottom: 12px;
    overflow: hidden;
}

.thinking-block-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    cursor: pointer;
    user-select: none;
    font-size: 13px;
    color: var(--text-secondary);
    transition: background 0.2s;
}

.thinking-block-header:hover {
    background: var(--bg-tertiary);
}

.thinking-block-header svg {
    flex-shrink: 0;
    animation: spinPulse 2s linear infinite;
}

.thinking-block-header svg.done {
    animation: none;
    color: var(--primary);
}

@keyframes spinPulse {
    0% { transform: rotate(0deg); opacity: 1; }
    50% { opacity: 0.4; }
    100% { transform: rotate(360deg); opacity: 1; }
}

.thinking-block-header .thinking-label {
    font-weight: 500;
    flex: 1;
}

.thinking-block-header .thinking-toggle {
    font-size: 11px;
    color: var(--text-secondary);
    transition: transform 0.2s;
}

.thinking-block-header .thinking-toggle.open {
    transform: rotate(180deg);
}

.thinking-block-body {
    padding: 10px 12px;
    font-size: 13px;
    color: var(--text-secondary);
    font-style: italic;
    line-height: 1.6;
    border-top: 1px solid var(--border);
    display: none;
    white-space: pre-wrap;
    max-height: 300px;
    overflow-y: auto;
}

.thinking-block-body.visible {
    display: block;
}

.thinking-dots {
    display: inline-flex;
    gap: 3px;
}

.thinking-dots span {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-secondary);
    animation: thinking 1.4s infinite;
}

.thinking-dots span:nth-child(2) { animation-delay: 0.2s; }
.thinking-dots span:nth-child(3) { animation-delay: 0.4s; }

@keyframes thinking {
    0%, 60%, 100% { opacity: 0.3; }
    30% { opacity: 1; }
}

/* Code Blocks */
.code-block-wrapper {
    position: relative;
    margin: 12px 0;
    border-radius: 8px;
    overflow: hidden;
}

.copy-code-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    color: #e5e5e5;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 10;
    opacity: 0;
}

.code-block-wrapper:hover .copy-code-btn { opacity: 1; }

.copy-code-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.3);
}

.copy-code-btn.copied {
    background: rgba(16, 163, 127, 0.2);
    border-color: var(--primary);
    color: var(--primary);
    opacity: 1;
}

.message-content pre {
    background: #1e1e1e;
    color: #e5e5e5;
    padding: 16px;
    padding-right: 50px;
    margin: 0;
    overflow-x: auto;
    font-size: 14px;
    border-radius: 8px;
    font-family: 'Courier New', 'Consolas', monospace;
}

.message-content code {
    background: var(--bg-tertiary);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 13px;
}

.message-content pre code {
    background: none;
    padding: 0;
    color: #e5e5e5;
}

/* Input Area */
.input-wrapper {
    border-top: 1px solid var(--border);
    background: var(--bg-primary);
    padding: 16px;
}

.image-preview-area {
    max-width: 800px;
    margin: 0 auto 12px;
    display: none;
}

.image-preview-container {
    position: relative;
    display: inline-block;
}

.image-preview-container img {
    max-width: 200px;
    max-height: 200px;
    border-radius: 8px;
    border: 1px solid var(--border);
}

.remove-image-btn {
    position: absolute;
    top: -6px;
    right: -6px;
    background: var(--text-primary);
    border: none;
    color: white;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
}

.input-area {
    max-width: 800px;
    margin: 0 auto;
}

.input-container {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding: 12px 16px;
    transition: border-color 0.2s;
}

.input-container:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(16, 163, 127, 0.1);
}

.input-toolbar {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-top: none;
    border-radius: 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 10px;
}

.input-icon-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    padding: 6px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
}

.input-icon-btn:hover {
    background: var(--hover-bg);
    color: var(--text-primary);
}

#userInput {
    flex: 1;
    background: none;
    border: none;
    padding: 8px 4px;
    color: var(--text-primary);
    font-size: 15px;
    resize: none;
    font-family: inherit;
    max-height: 120px;
    overflow-y: auto;
    outline: none;
}

#userInput::placeholder {
    color: var(--text-secondary);
}

.send-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    padding: 4px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
}

.send-btn:not(:disabled) { color: var(--primary); }
.send-btn:hover:not(:disabled) { opacity: 0.8; }
.send-btn:disabled { opacity: 0.3; cursor: not-allowed; }

.stop-btn {
    background: none;
    border: 1px solid #e53e3e;
    color: #e53e3e;
    padding: 6px 14px;
    border-radius: 20px;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    transition: all 0.2s;
    flex-shrink: 0;
}
.stop-btn:hover { background: #fee2e2; }
.stop-btn.visible { display: flex; }

/* Input toolbar (below textarea) */
.input-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 4px 2px;
}

.deep-think-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: none;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
}

.deep-think-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: rgba(16, 163, 127, 0.05);
}

.deep-think-btn.active {
    border-color: var(--primary);
    color: var(--primary);
    background: rgba(16, 163, 127, 0.1);
}

.deep-think-btn svg {
    transition: transform 0.4s ease;
}

.deep-think-btn.active svg {
    animation: tickTock 1s ease-in-out infinite alternate;
}

@keyframes tickTock {
    from { transform: rotate(-15deg); }
    to   { transform: rotate(15deg); }
}

/* Pasted Code Card */
.code-paste-card {
    display: none;
    max-width: 800px;
    margin: 0 auto 10px;
}

.code-paste-card-inner {
    display: inline-flex;
    flex-direction: column;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 12px;
    max-width: 200px;
    position: relative;
    box-shadow: 0 1px 4px var(--shadow);
}

.code-paste-preview {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: var(--text-secondary);
    line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    white-space: pre-wrap;
    word-break: break-all;
    margin-bottom: 8px;
    max-height: 80px;
}

.code-paste-label {
    display: inline-block;
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 3px 7px;
    border-radius: 4px;
    align-self: flex-start;
}

.code-paste-remove {
    position: absolute;
    top: -7px;
    right: -7px;
    background: var(--text-primary);
    border: none;
    color: white;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 12px;
    line-height: 1;
}

/* Error banner */
.error-banner {
    background: #fee2e2;
    border: 1px solid #fca5a5;
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 12px;
    font-size: 13px;
    color: #991b1b;
    display: none;
}

/* Scrollbar */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: var(--text-secondary); }

/* Mobile */
@media (max-width: 768px) {
    .sidebar {
        position: fixed;
        left: -260px;
        top: 0;
        height: 100vh;
        z-index: 1000;
        box-shadow: 2px 0 8px var(--shadow);
    }
    .sidebar.active { transform: translateX(260px); }
    .mobile-menu-btn { display: flex; }
    .top-bar { padding: 12px; }
    .chat-container { padding: 16px; }
    .welcome-screen { margin: 80px auto; }
    .welcome-screen h2 { font-size: 24px; }
    .input-wrapper { padding: 12px; }
    .auth-container { padding: 32px 24px; }
}

/* Dark Mode — applied via class OR system preference */
@media (prefers-color-scheme: dark) {
    :root:not(.theme-light) {
        --bg-primary: #212121;
        --bg-secondary: #2f2f2f;
        --bg-tertiary: #3f3f3f;
        --sidebar-bg: #171717;
        --text-primary: #ececec;
        --text-secondary: #9b9b9b;
        --border: #3f3f3f;
        --shadow: rgba(0, 0, 0, 0.3);
        --hover-bg: #2f2f2f;
    }
}

/* Force dark */
:root.theme-dark {
    --bg-primary: #212121;
    --bg-secondary: #2f2f2f;
    --bg-tertiary: #3f3f3f;
    --sidebar-bg: #171717;
    --text-primary: #ececec;
    --text-secondary: #9b9b9b;
    --border: #3f3f3f;
    --shadow: rgba(0, 0, 0, 0.3);
    --hover-bg: #2f2f2f;
}

/* Force light */
:root.theme-light {
    --bg-primary: #ffffff;
    --bg-secondary: #f7f7f8;
    --bg-tertiary: #ececf1;
    --sidebar-bg: #f9f9f9;
    --text-primary: #2e2e2e;
    --text-secondary: #6e6e80;
    --border: #e5e5e5;
    --shadow: rgba(0,0,0,0.05);
    --hover-bg: #f0f0f0;
}

/* Sidebar collapsed — floating reopen button */
.sidebar-reopen-btn {
    display: none;
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 200;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
