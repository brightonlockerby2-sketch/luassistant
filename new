const IMAGE_GEN_REGEX = /^(make\s+(me\s+)?(an?\s+)?image|generate\s+(an?\s+)?image|create\s+(an?\s+)?image|draw\s+(me\s+)?(an?\s+)?|paint\s+(me\s+)?(an?\s+)?|imagine\s+|render\s+(an?\s+)?image\s+of)\s+(.+)/i;
const HORDE_API = 'https://stablehorde.net/api/v2';

function detectImageGenPrompt(message) {
    const match = message.match(IMAGE_GEN_REGEX);
    if (match) return match[match.length - 1].trim();
    return null;
}

async function generateAndShowImage(prompt, signal) {
    if (signal?.aborted) throw new DOMException('Aborted', 'AbortError');

    // --- Build the bubble immediately with a spinner ---
    const messageDiv = document.createElement('div');
    messageDiv.className = 'message bot-message';

    const avatar = document.createElement('div');
    avatar.className = 'message-avatar bot-avatar';
    avatar.textContent = 'L';

    const content = document.createElement('div');
    content.className = 'message-content';
    content.style.paddingTop = '4px';

    const label = document.createElement('div');
    label.style.cssText = 'font-size:13px;color:var(--text-secondary);margin-bottom:8px';
    label.textContent = `Image: "${prompt}"`;

    const spinner = document.createElement('div');
    spinner.style.cssText = 'width:512px;max-width:100%;height:300px;background:var(--bg-secondary);border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:var(--text-secondary);font-size:13px;border:1px solid var(--border)';
    spinner.innerHTML = `
        <span class="thinking-dots" style="font-style:normal;gap:6px"><span></span><span></span><span></span></span>
        <span id="imgGenStatus" style="font-size:12px;color:var(--text-secondary)">Submitting to Stable Horde…</span>`;

    const img = document.createElement('img');
    img.className = 'message-image';
    img.alt = prompt;
    img.style.cssText = 'max-width:512px;display:none;border-radius:12px';

    const dlBtn = document.createElement('a');
    dlBtn.target = '_blank';
    dlBtn.rel = 'noopener noreferrer';
    dlBtn.style.cssText = 'display:none;margin-top:8px;font-size:13px;color:var(--primary);text-decoration:none';
    dlBtn.textContent = '⬇ Open full image';

    const errLabel = document.createElement('div');
    errLabel.style.cssText = 'display:none;font-size:13px;color:#e53e3e;margin-top:8px';

    content.appendChild(label);
    content.appendChild(spinner);
    content.appendChild(img);
    content.appendChild(dlBtn);
    content.appendChild(errLabel);
    messageDiv.appendChild(avatar);
    messageDiv.appendChild(content);
    chatContainer.appendChild(messageDiv);
    scrollToBottom();

    const statusEl = spinner.querySelector('#imgGenStatus');
    const setStatus = (txt) => { if (statusEl) statusEl.textContent = txt; };

    const abortCheck = () => {
        if (signal?.aborted) throw new DOMException('Aborted', 'AbortError');
    };

    try {
        // 1. Submit generation job
        abortCheck();
        const submitRes = await fetch(`${HORDE_API}/generate/async`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'apikey': '0000000000' },
            body: JSON.stringify({
                prompt,
                params: { width: 512, height: 512, steps: 25, n: 1, sampler_name: 'k_euler_a', cfg_scale: 7 },
                models: ['stable_diffusion'],
                nsfw: false,
                censor_nsfw: true
            }),
            signal
        });

        if (!submitRes.ok) {
            const err = await submitRes.json().catch(() => ({}));
            throw new Error(err.message || `Submit failed (HTTP ${submitRes.status})`);
        }

        const { id } = await submitRes.json();
        if (!id) throw new Error('No job ID returned from Stable Horde');

        // 2. Poll until done (up to 3 minutes)
        const deadline = Date.now() + 180000;
        let imageBase64 = null;

        while (Date.now() < deadline) {
            abortCheck();
            await new Promise(r => setTimeout(r, 4000)); // poll every 4s
            abortCheck();

            const checkRes = await fetch(`${HORDE_API}/generate/check/${id}`, { signal });
            if (!checkRes.ok) continue;
            const check = await checkRes.json();

            const pos = check.queue_position ?? '?';
            const wait = check.wait_time ?? '?';
            setStatus(`Queue position: ${pos} — ~${wait}s remaining…`);

            if (check.done) {
                // Fetch final result
                const statusRes = await fetch(`${HORDE_API}/generate/status/${id}`, { signal });
                if (!statusRes.ok) throw new Error('Failed to retrieve generated image');
                const statusData = await statusRes.json();
                const gen = statusData.generations?.[0];
                if (!gen?.img) throw new Error('No image in response');
                imageBase64 = gen.img; // base64 PNG
                break;
            }
        }

        if (!imageBase64) throw new Error('Image generation timed out. Try again or use a simpler prompt.');

        // 3. Display the image
        spinner.remove();
        const dataUrl = imageBase64.startsWith('data:') ? imageBase64 : `data:image/webp;base64,${imageBase64}`;
        img.src = dataUrl;
        img.style.display = 'block';
        dlBtn.href = dataUrl;
        dlBtn.download = 'generated.png';
        dlBtn.textContent = '⬇ Download image';
        dlBtn.style.display = 'inline-block';

    } catch (err) {
        if (err.name === 'AbortError') {
            messageDiv.remove();
            throw err;
        }
        spinner.remove();
        errLabel.style.display = 'block';
        errLabel.textContent = `Image generation failed: ${err.message}`;
        console.error('Image gen error:', err);
    }

    // Save to chat history
    chatHistory.push({ text: `*Generated image for:* "${prompt}"`, sender: 'bot', timestamp: Date.now() });
    if (currentChatId && allChats[currentChatId]) { saveAllChats(); renderChatList(); }
    scrollToBottom();
}

