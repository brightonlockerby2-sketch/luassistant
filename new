function createNewChat() {
    const chatId = 'chat_' + Date.now();
    currentChatId = chatId;
    allChats[chatId] = { id: chatId, title: 'New Chat', messages: [], createdAt: Date.now() };
    chatHistory = allChats[chatId].messages; // same reference — stays in sync automatically
    chatContainer.innerHTML = '<div class="welcome-screen"><h2>Ready when you are.</h2></div>';
    saveAllChats();
    renderChatList();
}

function switchToChat(chatId) {
    currentChatId = chatId;
    if (!allChats[chatId].messages) allChats[chatId].messages = [];
    chatHistory = allChats[chatId].messages; // same reference — stays in sync automatically
    chatContainer.innerHTML = '';
    if (chatHistory.length === 0) {
        chatContainer.innerHTML = '<div class="welcome-screen"><h2>Ready when you are.</h2></div>';
    } else {
        chatHistory.forEach(msg => addMessageToDOM(msg.text, msg.sender, msg.image));
    }
    renderChatList();
    scrollToBottom();
}

function deleteChat(chatId, event) {
    event.stopPropagation();
    if (confirm('Delete this chat?')) {
        delete allChats[chatId];
        if (currentChatId === chatId) { createNewChat(); } else { saveAllChats(); renderChatList(); }
    }
}

function renderChatList() {
    const chats = Object.values(allChats).sort((a, b) => b.createdAt - a.createdAt);
    chatList.innerHTML = '';
    chats.forEach(chat => {
        const chatItem = document.createElement('div');
        chatItem.className = 'chat-item' + (chat.id === currentChatId ? ' active' : '');
        const title = document.createElement('div');
        title.className = 'chat-item-title';
        title.textContent = chat.title;
        const deleteBtn = document.createElement('button');
        deleteBtn.className = 'delete-chat-btn';
        deleteBtn.textContent = '🗑️';
        deleteBtn.onclick = (e) => deleteChat(chat.id, e);
        chatItem.appendChild(title);
        chatItem.appendChild(deleteBtn);
        chatItem.addEventListener('click', () => { switchToChat(chat.id); sidebar.classList.remove('active'); });
        chatList.appendChild(chatItem);
    });
}

